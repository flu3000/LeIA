meta {
  name: Enviar Denúncia
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/reports
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "reported_user_id": "uuid-do-usuario",
    "reason": "spam",
    "description": "Descrição da denúncia."
  }
}

assert {
  res.status: eq 201
}
