meta {
  name: Postar Nova Citação
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/quotes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{authToken}}
}

body:json {
  {
    "book_id": 1,
    "content": "A citação do livro vai aqui.",
    "page": 42
  }
}

assert {
  res.status: eq 201
}
