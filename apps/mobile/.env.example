# Supabase — copie do painel do Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend URLs — use IP local (ex: 192.168.x.x) em dispositivos físicos
# NÃO use localhost em dispositivos físicos/emuladores Android
EXPO_PUBLIC_CHAT_URL=http://localhost:3001
EXPO_PUBLIC_BACKEND_URL=http://localhost:3002
