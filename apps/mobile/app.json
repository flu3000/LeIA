{
  "expo": {
    "name": "LeIA",
    "slug": "leia-app",
    "scheme": "leia-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#001015",
    "icon": "./assets/images/logo_definitiva.svg",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "backgroundColor": "#001015",
      "supportsTablet": true,
      "bundleIdentifier": "com.flu3000.leiaapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#001015",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "backgroundColor": "#001015",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#001015",
          "dark": {
            "backgroundColor": "#001015"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "O LeIA precisa acessar sua galeria para você trocar a foto de perfil."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
